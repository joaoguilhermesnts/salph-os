#!/bin/sh
# SALPH OS — live-build configuration (Phase 1: base and build)
# Chamado automaticamente por `lb config`. Não execute diretamente.
# Called automatically by `lb config`. Do not run directly.
set -e

# Espelho: deb.debian.org por padrão; SALPH_SNAPSHOT=AAAAMMDDTHHMMSSZ congela
# o estado do arquivo em snapshot.debian.org para builds reproduzíveis.
if [ -n "${SALPH_SNAPSHOT:-}" ]; then
	MIRROR="http://snapshot.debian.org/archive/debian/${SALPH_SNAPSHOT}/"
	MIRROR_SECURITY="http://snapshot.debian.org/archive/debian-security/${SALPH_SNAPSHOT}/"
else
	MIRROR="http://deb.debian.org/debian/"
	MIRROR_SECURITY="http://security.debian.org/debian-security/"
fi

# O que vai na ISO final (imagem instalada) sempre aponta para os espelhos normais.
MIRROR_BINARY="http://deb.debian.org/debian/"
MIRROR_BINARY_SECURITY="http://security.debian.org/debian-security/"

# Decisão 0003: "non-free" fica habilitado nas fontes do sistema instalado para
# permitir `apt install nvidia-driver` depois; nenhum pacote non-free vai na ISO.
ARCHIVE_AREAS="${SALPH_ARCHIVE_AREAS:-main contrib non-free non-free-firmware}"

lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures amd64 \
	--linux-flavours amd64 \
	--archive-areas "${ARCHIVE_AREAS}" \
	--parent-archive-areas "${ARCHIVE_AREAS}" \
	--mirror-bootstrap "${MIRROR}" \
	--mirror-chroot "${MIRROR}" \
	--mirror-chroot-security "${MIRROR_SECURITY}" \
	--mirror-binary "${MIRROR_BINARY}" \
	--mirror-binary-security "${MIRROR_BINARY_SECURITY}" \
	--security true \
	--updates true \
	--backports true \
	--apt-recommends true \
	--firmware-chroot true \
	--firmware-binary true \
	--binary-image iso-hybrid \
	--bootloaders "grub-efi,syslinux" \
	--uefi-secure-boot enable \
	--debian-installer none \
	--iso-application "SALPH OS" \
	--iso-publisher "SALPH OS project" \
	--iso-volume "SALPH_OS_${SALPH_VERSION:-dev}" \
	--image-name "salph-os-${SALPH_VERSION:-dev}" \
	--bootappend-live "boot=live components quiet splash locales=pt_BR.UTF-8 keyboard-layouts=br keyboard-model=abnt2 timezone=America/Sao_Paulo username=salph hostname=salph-os" \
	--memtest none \
	--source "${SALPH_SOURCE:-false}" \
	--source-images iso \
	--cache true \
	--cache-packages true \
	"${@}"
